<style>
  .use-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
  .use{padding:30px}
  .use span{font-size:40px;color:#f5b638;line-height:1}
  .use h3{margin:14px 0 8px;font-size:22px}
  .use p{color:#a9b7c9;line-height:1.7;margin:0}
  .note{margin:26px 0 0;color:#d0d7e4;font-size:18px;line-height:1.7;max-width:760px}
  .note.small{font-size:13px;color:#8a98ad;margin-top:14px}
  .art-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .art{margin:0}
  .art svg{display:block;width:100%;height:auto;border-radius:16px;border:1px solid #35435a}
  .art figcaption{text-align:center;color:#a9b7c9;font-size:14px;margin-top:10px}
  .disclosure{border:1px solid #4b3d2a;background:#111b2d;border-radius:12px;padding:16px 20px;color:#aab7ca;font-size:14px;line-height:1.7;margin-bottom:34px}
  .exchange-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .exchange{padding:26px;display:flex;flex-direction:column;gap:20px;justify-content:space-between}
  .ex-head{display:flex;align-items:center;gap:14px}
  .ex-head h3{margin:0;font-size:22px;line-height:1.2}
  .ex-head p{margin:2px 0 0;color:#a9b7c9;font-size:14px}
  .ex-logo{width:56px;height:56px;border-radius:12px;display:block;flex:none}
  .offer{margin:0;color:#d0d7e4;font-size:15px;line-height:1.8}
  .code{display:inline-block;background:#0a101b;border:1px dashed #f5b638;border-radius:8px;padding:2px 10px;font-weight:700;color:#f5b638;letter-spacing:.06em}
  .safety{margin-top:18px;padding:26px 30px}
  .safety h3{margin:0 0 8px;font-size:20px;color:#f5b638}
  .safety p{margin:0;color:#aab7ca;line-height:1.7}
  @media(max-width:850px){.use-grid{grid-template-columns:1fr}.art-grid{grid-template-columns:repeat(2,1fr)}.exchange-grid{grid-template-columns:1fr}}
</style>
