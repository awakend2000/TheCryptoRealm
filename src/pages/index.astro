---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Base title="The Crypto Realm | The Future Is Decentralized">
<section class="hero"><div class="hero-grid"></div><div class="hero-glow"></div><div class="container hero-inner"><div class="hero-copy"><div class="hero-label"><span class="dot"></span> WELCOME TO THE CRYPTO REALM</div><h1>THE FUTURE IS <span>DECENTRALIZED.</span></h1><p>Independent crypto news, financial freedom, and the ideas shaping a world beyond centralized control.</p><div class="hero-actions"><a class="btn btn-primary" href="#news">EXPLORE THE REALM ↗</a><a class="btn btn-outline" href="#videos">WATCH THE LATEST ▷</a></div><div class="hero-foot"><span>◈ INDEPENDENT THINKING</span><span>◈ FINANCIAL SOVEREIGNTY</span></div></div><div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="coin"><span>₿</span></div><div class="spark spark-a">✦</div><div class="spark spark-b">✧</div></div></div></section>
<section class="container section shortcuts"><div class="shortcut-grid"><a href="#news" class="shortcut"><div class="shortcut-icon">▤</div><div><strong>LATEST NEWS</strong><small>Stories worth following</small></div><span class="arrow">↗</span></a><a href="#videos" class="shortcut"><div class="shortcut-icon">▷</div><div><strong>VIDEOS</strong><small>Watch the conversation</small></div><span class="arrow">↗</span></a><a href="/trade" class="shortcut"><div class="shortcut-icon">⇄</div><div><strong>TRADE</strong><small>Buy crypto, own your keys</small></div><span class="arrow">↗</span></a><a href="#merch" class="shortcut"><div class="shortcut-icon">◇</div><div><strong>MERCHANDISE</strong><small>Represent the realm</small></div><span class="arrow">↗</span></a></div></section>
<section class="container section" id="news"><div class="section-head"><div><div class="eyebrow">THE REALM REPORT</div><h2>Latest from the Realm</h2></div><a class="textlink" href="/articles">ALL ARTICLES ↗</a></div><div class="article-grid">{articles.map((article,i)=><a class="card story" href={`/articles/${article.id}/`}><div class={`story-art art-${i%3}`}><span>{i===0?'₿':i===1?'◈':'◎'}</span></div><div class="article-item"><div class="date">{article.data.date.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})} · THE CRYPTO REALM</div><h3>{article.data.title}</h3><p>{article.data.description}</p><span class="textlink">READ ARTICLE ↗</span></div></a>)}</div></section>
<section class="container section" id="videos"><div class="section-head"><div><div class="eyebrow">WATCH & THINK</div><h2>Video Spotlight</h2></div></div><div class="feature-grid"><div class="video-embed"><iframe src="https://www.youtube-nocookie.com/embed/J9tMe0_Jz4A" title="The Crypto Realm featured video" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><div class="feature-copy"><div class="eyebrow">INDEPENDENT MEDIA</div><h2>Question the narrative.<br/><em>Explore the evidence.</em></h2><p class="subtle">Watch conversations about crypto, financial systems, privacy, and the future of decentralization. We also cover whistleblowers, government overreach and other sensitive topics the mainstream media often skips.</p><div class="hero-actions"><a class="btn btn-primary" href="https://www.youtube.com/@TheCryptoRealm.Decentralized" target="_blank" rel="noopener">WATCH ON YOUTUBE ↗</a><a class="btn btn-outline" href="https://rumble.com/user/TheCryptoRealm" target="_blank" rel="noopener">WATCH ON RUMBLE ↗</a></div></div></div></section>
<section class="container section" id="crypto"><div class="section-head"><div><div class="eyebrow">THE BIGGER PICTURE</div><h2>Explore the ideas</h2></div></div><div class="topic-grid"><div class="card topic"><span>₿</span><h3>Bitcoin & Crypto</h3><p>Understand the technology, the debates, and the changing digital economy.</p></div><div class="card topic"><span>⌘</span><h3>Decentralization</h3><p>Explore systems that give people more choice, ownership, and control.</p></div><div class="card topic"><span>◇</span><h3>Financial Freedom</h3><p>Independent perspectives on money, privacy, and self-custody.</p></div><div class="card topic"><span>◉</span><h3>Whistleblowers & Transparency</h3><p>Leaked documents, court records and testimony that powerful institutions would rather keep quiet.</p></div><div class="card topic"><span>△</span><h3>Surveillance & Digital ID</h3><p>How data collection, tracking and digital identity affect your privacy and your freedom.</p></div><div class="card topic"><span>✦</span><h3>Power & Institutions</h3><p>Questions about banks, governments, big pharma and who the systems that shape daily life really answer to.</p></div></div></section>
<section class="container section" id="endgame"><div class="endgame"><div class="endgame-copy"><div class="eyebrow">THE END GAME</div><h2>Orwell saw it coming.<br/><span>Do you?</span></h2><p class="subtle">The closest you’ll get to what the end game is all about.</p><a class="btn btn-primary" href="https://a.co/d/01iw16On" target="_blank" rel="noopener sponsored">GET THE BOOK ↗</a><p class="affiliate-note">As an Amazon Associate I earn from qualifying purchases.</p></div><a class="endgame-book" href="https://a.co/d/01iw16On" target="_blank" rel="noopener sponsored" aria-label="Get 1984 by George Orwell"><img src="data:image/webp;base64," alt="1984 by George Orwell book cover" width="260" height="394" loading="lazy"/></a></div></section>
<section class="container section" id="merch"><div class="merch-panel"><div><div class="eyebrow">WEAR THE MESSAGE</div><h2>REPRESENT<br/><span>THE REALM.</span></h2><p class="subtle">Bitcoin-inspired apparel, bold designs, and original artwork.</p><a class="btn btn-primary" href="https://bitcointshirts.redbubble.com" target="_blank" rel="noopener">SHOP ON REDBUBBLE ↗</a></div><div class="merch-symbol" aria-hidden="true">₿</div></div></section>
</Base>
<style>.endgame .affiliate-note{font-size:12px;color:#8a98ad;margin:14px 0 0;max-width:none}.endgame{background:radial-gradient(circle at 80% 50%,#6f501a55,transparent 45%),linear-gradient(110deg,#1c2a3d,#0d1422);border:1px solid #4b3d2a;border-radius:20px;padding:48px 60px;display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:center}.endgame h2{font-size:clamp(35px,5vw,58px);line-height:1.05;margin:15px 0}.endgame h2 span{color:#f5b638}.endgame p{max-width:460px;margin-bottom:26px}.endgame-book{justify-self:center;display:block;width:min(260px,70%);transition:transform .25s ease}.endgame-book img{display:block;width:100%;height:auto;border-radius:6px;box-shadow:0 22px 60px #000b,0 0 50px #f5b63826}.endgame-book:hover{transform:translateY(-6px) rotate(-1.5deg)}.endgame-book:focus-visible{outline:2px solid #f5b638;outline-offset:6px}@media(max-width:850px){.endgame{grid-template-columns:1fr;padding:30px;gap:28px}.endgame-book{width:min(240px,70%)}}
.video-embed{position:relative;aspect-ratio:9/16;width:100%;max-width:320px;margin:0 auto;border-radius:16px;overflow:hidden;border:1px solid #35435a;background:#000}.video-embed iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.hero{position:relative;overflow:hidden;min-height:580px;background:radial-gradient(ellipse at 76% 52%,#48331870,transparent 37%),linear-gradient(110deg,#0b1426,#0b101b 68%,#141b27)}.hero-grid{position:absolute;inset:0;background-image:linear-gradient(#f4b83b0c 1px,transparent 1px),linear-gradient(90deg,#f4b83b0c 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(90deg,transparent,#000)}.hero-glow{position:absolute;right:5%;top:10%;width:480px;height:480px;background:#d8961922;filter:blur(95px);border-radius:50%}.hero-inner{min-height:580px;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;position:relative}.hero-copy{padding:68px 0;z-index:1}.hero-label{font-size:11px;font-weight:700;letter-spacing:.22em;color:#e8b75b;display:flex;align-items:center;gap:12px}.dot{width:8px;height:8px;border-radius:50%;background:#e9b04b;box-shadow:0 0 15px #e9b04b}.hero h1{font-size:clamp(45px,5.5vw,78px);line-height:1.05;letter-spacing:-.05em;margin:26px 0;max-width:720px}.hero h1 span{display:block;background:linear-gradient(100deg,#ffdc87,#e9a52e,#c47b1d);background-clip:text;-webkit-text-fill-color:transparent}.hero p{font-size:17px;color:#aebcd1;line-height:1.8;max-width:520px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.hero-foot{display:flex;gap:24px;flex-wrap:wrap;margin-top:55px;color:#a7b4c7;font-size:10px;letter-spacing:.14em}.hero-art{position:relative;height:470px;display:grid;place-items:center}.coin{position:relative;width:300px;height:300px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 30% 22%,#ffe9a0,#edb94c 25%,#9e6519 65%,#4b2d0c);border:12px ridge #d9a340;box-shadow:inset 0 0 0 9px #a06d27,inset 0 0 0 13px #f8d77d,0 0 90px #e7a52755,30px 30px 65px #000a;transform:rotate(-13deg)}.coin span{font-size:180px;color:#7b4a10;text-shadow:2px 2px 1px #ffdf7a,-2px -2px 2px #5e390e;font-family:Arial,sans-serif;font-weight:700}.orbit{position:absolute;width:390px;height:390px;border:1px solid #d9a34035;border-radius:50%;transform:rotateX(65deg) rotate(-30deg)}.orbit-two{width:470px;height:470px;transform:rotateY(65deg) rotate(25deg)}.spark{position:absolute;color:#f5c46e;font-size:35px}.spark-a{top:40px;right:40px}.spark-b{bottom:48px;left:24px}.shortcut-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.shortcut{display:flex;align-items:center;gap:12px;padding:24px 16px;border:1px solid #344156;border-radius:12px;background:linear-gradient(135deg,#18253a,#111b2b);transition:transform .2s,border-color .2s}.shortcut:hover{transform:translateY(-3px);border-color:#f5b638}.shortcut-icon{width:44px;height:44px;display:grid;place-items:center;color:#f7bd50;background:#f5b63813;border:1px solid #f5b63845;border-radius:10px;font-size:27px}.shortcut strong{display:block;font-size:12px;letter-spacing:.08em}.shortcut small{display:block;color:#9aabc2;font-size:11px;margin-top:6px}.arrow{color:#e7b455;margin-left:auto}.story{display:block;transition:transform .2s}.story:hover{transform:translateY(-4px)}.story-art{height:160px;display:grid;place-items:center;background:radial-gradient(circle,#aa6e2066,transparent 58%),linear-gradient(135deg,#17243a,#0b1322);border-bottom:1px solid #28384c}.story-art span{font-size:100px;color:#f1b443;text-shadow:0 0 45px #e6a62e80}.art-1{background:radial-gradient(circle,#2b6b8a66,transparent 58%),linear-gradient(135deg,#162a3d,#0b1322)}.art-2{background:radial-gradient(circle,#614c8a66,transparent 58%),linear-gradient(135deg,#1a1d3d,#0b1322)}.feature-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:34px;align-items:center}.video-placeholder{height:310px;border-radius:16px;background:radial-gradient(circle at 50% 45%,#8d672c44,transparent 40%),linear-gradient(135deg,#192b43,#0b1221);border:1px solid #35435a;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px}.video-placeholder strong{font-size:22px;letter-spacing:.12em}.video-placeholder span{color:#a4b1c4;font-size:13px}.play{height:74px;width:74px;border-radius:50%;display:grid;place-items:center;background:#f5b638;color:#111827;font-size:24px;box-shadow:0 0 50px #f5b63855}.feature-copy h2{line-height:1.2;font-size:clamp(28px,3vw,42px);margin:12px 0}.feature-copy em{color:#f5b638;font-style:normal}.topic-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.topic{padding:32px}.topic span{font-size:45px;color:#f5b638}.topic h3{font-size:21px;margin:20px 0 8px}.topic p{color:#a9b7c9;line-height:1.7}.merch-panel{background:radial-gradient(circle at 75% 50%,#6f501a66,transparent 40%),linear-gradient(110deg,#1c2a3d,#0d1422);border:1px solid #4b3d2a;border-radius:20px;padding:48px 60px;display:flex;justify-content:space-between;align-items:center;overflow:hidden}.merch-panel h2{font-size:clamp(35px,5vw,58px);line-height:1.05;margin:15px 0}.merch-panel h2 span{color:#f5b638}.merch-panel p{max-width:460px}.merch-symbol{font-size:210px;color:#f4b93e;text-shadow:0 0 80px #e6a52b88;transform:rotate(-15deg);padding-right:30px}@media(max-width:850px){.hero-inner{grid-template-columns:1fr}.hero-art{position:absolute;right:-100px;top:50px;opacity:.22}.hero-copy{max-width:660px}.shortcut-grid{grid-template-columns:repeat(2,1fr)}.feature-grid{grid-template-columns:1fr}.topic-grid{grid-template-columns:1fr}.merch-symbol{font-size:130px}}@media(max-width:500px){.hero h1{font-size:43px}.hero-foot{gap:12px}.shortcut-grid{grid-template-columns:1fr 1fr}.shortcut{padding:16px 10px;gap:8px}.shortcut-icon{width:36px;height:36px;font-size:21px}.shortcut strong{font-size:10px}.shortcut small{font-size:10px}.merch-panel{padding:30px}.merch-symbol{display:none}}
</style>
