---
const { title = 'The Crypto Realm', description = 'Independent crypto news, financial freedom and decentralized thinking.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="description" content={description}/><meta name="theme-color" content="#080d19"/><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/><style is:global>
:root{color-scheme:dark;--bg:#080d19;--panel:#111b2d;--muted:#9baac2;--gold:#f5b638;--line:#27354b}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:#f8fafc;font-family:'DM Sans',sans-serif}a{color:inherit;text-decoration:none}button{font:inherit}h1,h2,h3,p{margin-top:0}h1,h2,h3,.brand{font-family:'Space Grotesk',sans-serif}.container{width:min(1160px,calc(100% - 40px));margin:auto}.topbar{border-bottom:1px solid #243048;background:#090f1d}.topbar .container{display:flex;justify-content:space-between;align-items:center;min-height:36px;color:#aebbd1;font-size:11px;letter-spacing:.12em;text-transform:uppercase}.status{color:#f5b638}.header{position:sticky;top:0;z-index:10;background:#0b1220f2;backdrop-filter:blur(14px);border-bottom:1px solid #27354b}.header-inner{display:flex;align-items:center;justify-content:space-between;gap:22px;min-height:82px}.brandwrap{display:flex;align-items:center;gap:13px}.brandmark{width:48px;height:48px;display:grid;place-items:center;border:1px solid #c58b2b;border-radius:12px;color:#ffcb57;font-size:31px;font-weight:700;background:linear-gradient(145deg,#352714,#151a25);box-shadow:0 0 30px #f5b63822}img.brandmark{display:block;object-fit:cover;padding:0}.brand{font-weight:700;font-size:20px;letter-spacing:.045em}.tagline{color:#b4a17c;font-size:10px;letter-spacing:.22em;margin-top:3px}.nav{display:flex;gap:26px;align-items:center}.nav a{font-size:13px;color:#bdc9da;font-weight:700}.nav a:hover{color:var(--gold)}.nav .nav-cta{color:#10141c;background:var(--gold);padding:12px 17px;border-radius:7px}.footer{padding:48px 0;border-top:1px solid var(--line);margin-top:55px;color:#a4b1c4;font-size:13px}.footer-grid{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap}.footer a{color:#f5b638}.section{padding:48px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:24px}.eyebrow{color:var(--gold);font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase}.section h2{font-size:clamp(26px,3vw,36px);margin:8px 0 0}.subtle{color:var(--muted);line-height:1.7}.textlink{color:var(--gold);font-size:13px;font-weight:700}.card{border:1px solid var(--line);background:linear-gradient(155deg,#172338,#101827);border-radius:14px;overflow:hidden}.btn{display:inline-flex;align-items:center;justify-content:center;padding:15px 22px;border-radius:8px;font-weight:700;font-size:13px;letter-spacing:.03em}.btn-primary{background:var(--gold);color:#111827;box-shadow:0 10px 35px #d79b282a}.btn-outline{border:1px solid #647087;color:#fff}.btn:hover{filter:brightness(1.12)}.page-title{padding:70px 0 28px}.page-title h1{font-size:clamp(34px,5vw,58px);margin:8px 0}.article-body{max-width:760px;line-height:1.9;color:#d1daea;font-size:17px}.article-body a{color:var(--gold);text-decoration:underline}.article-body h2{color:#fff;margin-top:32px}.article-item{padding:24px}.article-item h3{font-size:21px;margin:12px 0}.article-item p{color:#aab7ca;line-height:1.65}.date{font-size:11px;color:#f5b638;text-transform:uppercase;letter-spacing:.14em}.article-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}@media(max-width:800px){.header-inner{flex-wrap:wrap;padding:14px 0}.nav{width:100%;justify-content:space-between;gap:8px;flex-wrap:wrap}.nav a{font-size:12px}.article-grid{grid-template-columns:1fr}.brand{font-size:17px}.topbar .container{font-size:9px}}
</style></head><body><div class="topbar"><div class="container"><span>CRYPTO · FREEDOM · TRUTH</span><span class="status">● THE REALM IS OPEN</span></div></div><header class="header"><div class="container header-inner"><a href="/" class="brandwrap" aria-label="The Crypto Realm home"><img class="brandmark" src="data:image/jpeg;base64," alt="" width="48" height="48"/><span><span class="brand">THE CRYPTO REALM</span><div class="tagline">DECENTRALIZE YOUR WORLD</div></span></a><nav class="nav" aria-label="Main navigation"><a href="/#news">NEWS</a><a href="/#videos">VIDEOS</a><a href="/#crypto">CRYPTO</a><a href="/trade">TRADE</a><a href="/#merch">MERCHANDISE</a><a href="/articles">ARTICLES</a><a href="/about">ABOUT</a></nav></div></header><main><slot/></main><footer class="footer"><div class="container footer-grid"><div><strong>THE CRYPTO REALM</strong><p>Independent voices. Decentralized ideas.</p></div><div>© {new Date().getFullYear()} The Crypto Realm · <a href="/articles">Read articles</a> · <a href="/trade">Trade</a> · <a href="/about">About</a> · <a href="/disclaimer">Disclaimer</a></div></div></footer></body></html>
